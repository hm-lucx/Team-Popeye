# Catchup backend staging configuration

NODE_ENV=production
HOST=0.0.0.0
PORT=3001

# Public backend base URL used by clients
APP_BASE_URL=https://api-staging.catchup.example

# Hosted Postgres connection string
DATABASE_URL=postgres://catchup_user:replace-me@db-host:5432/catchup_staging

# Use require for managed Postgres providers. Use no-verify only if required by the host.
DATABASE_SSL_MODE=require

# Allowed frontend origin for staging
CORS_ORIGIN=https://staging.catchup.example

# Generate a long random secret before deploy
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret
JWT_ISSUER=catchup-api
JWT_AUDIENCE=catchup-app
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# SSE heartbeat in seconds
SSE_HEARTBEAT_SECONDS=25

# Enable the background maintenance sweep on exactly one backend instance
ENABLE_SCHEDULED_JOBS=true
MAINTENANCE_SWEEP_SECONDS=30

# Keep mock first for staging until the app flow is stable
CALL_PROVIDER=mock
CALL_ROOM_TTL_MINUTES=90
CALL_JOIN_TOKEN_TTL_MINUTES=30

# Fill these only when switching to CALL_PROVIDER=daily
DAILY_API_KEY=
DAILY_DOMAIN=
DAILY_API_URL=https://api.daily.co/v1
